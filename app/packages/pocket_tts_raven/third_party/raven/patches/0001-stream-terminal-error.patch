# 0001-stream-terminal-error: adds ptt_stream_error() + terminal error
#   capture on the stream context so the app can distinguish a failed
#   stream from a clean end (plan section 5.4). Against upstream rev
#   abd26158ab50f954616eaf42296b09c4856489d7.

--- a/include/pocket_tts.h	2026-09-01 20:05:26
